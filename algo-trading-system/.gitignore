# .gitignore for a Python + FastAPI project

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
*.egg-info/
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/

# Virtual environments
venv/
ENV/
env/
.venv/
venv.bak/
env.bak/
__pypackages__/

# dotenv / secrets / local config
.env
.env.*
*.secret
local_settings.py
instance/

# Database files
*.sqlite3
*.db
*.sql
*.sqlite3-journal

# Logs
*.log
logs/
*.pid

# IDEs / editors
.vscode/
.idea/
*.iml
*.iws
*.sublime-project
*.sublime-workspace
.history/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Sphinx / docs
docs/_build/

# PyInstaller
*.spec

# PyBuilder
target/

# Jupyter
.ipynb_checkpoints

# Static / frontend (if present)
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker / Compose local overrides
docker-compose.override.yml
*.env.local

# Misc
*.cover
*.py,cover
*.mo
*.pot
*.manifest